# --- MongoDB (required) ---
# Atlas connection string: Atlas > Connect > Drivers
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=workout_planner

# --- GitHub history (optional, but it's the point of the demo) ---
# Fine-grained token with "Contents: Read and write" on ONE data repo
GITHUB_TOKEN=github_pat_xxx
GITHUB_OWNER=your-github-username
GITHUB_REPO=workout-data
GITHUB_BRANCH=main

PORT=4000
